mach create "can1"
machine LoadPlatformDescription @boards/arm/ut_core/ut_core.repl
machine StartGdbServer 3330
showAnalyzer lpuart1
sysbus LoadELF @build/apps/test/CANtest1/zephyr/zephyr.elf

mach create "can2"
machine LoadPlatformDescription @boards/arm/ut_core/ut_core.repl
machine StartGdbServer 3331
showAnalyzer lpuart1
sysbus LoadELF @build/apps/test/CANtest2/zephyr/zephyr.elf


emulation CreateCANHub "canHub"

mach set "can1"
connector Connect sysbus.fdcan1 canHub

mach set "can2"
connector Connect sysbus.fdcan1 canHub

# start
